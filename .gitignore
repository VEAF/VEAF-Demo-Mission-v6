# VEAF Mission Creation Tools — generated/downloaded files (never commit these)

# VEAF tools executables (downloaded by the updater)
/veaf*.exe

# Published VEAF scripts (downloaded by the build pipeline)
/published/

# Build output — generated .miz files and weather variants
# (the mission is built from src/; force-add a base .miz with `git add -f` if you commit one)
*.miz
/missions/
*.miz.bak

# Backups the mission-editing tools (MCP) take before every write, and the presets report of each build
/.veaf-backups/
/presets-validation-report.md

# OS / editor noise
.DS_Store
Thumbs.db

# Mission de test locale (tools/make_test_mission.py) : jamais dans les sources
/missions-test/

# Produits du build, régénérés depuis mission.yaml à chaque construction
src/scripts/veaf-config.lua
src/scripts/veafDynamicConfig.lua

# Outils DCS téléchargés à côté de la mission
/dcs-client.exe
/dcs-serve.exe
*.log

# Python
__pycache__/
*.pyc
